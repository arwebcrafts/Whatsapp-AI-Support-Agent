generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String   @id @default(uuid())
  email                String   @unique
  name                 String?
  password             String
  company              String?
  phone                String?
  emailVerified        Boolean  @default(false)
  verificationToken    String?  @unique
  verificationTokenExpiry DateTime?
  role                 String   @default("user") // 'user', 'admin', 'developer'
  createdAt            DateTime @default(now())
  trialEndsAt          DateTime?
  subscriptionStatus   String   @default("trial") // 'trial', 'active', 'cancelled', 'lifetime', 'expired'
  planType             String   @default("starter") // 'starter', 'professional', 'business'
  billingInterval      String?  @default("monthly") // 'monthly', 'yearly', null for lifetime
  stripeCustomerId     String?  @unique

  agents               Agent[]
  whatsappConnections  WhatsAppConnection[]
  conversations        Conversation[]
  knowledgeBase        KnowledgeBase[]
  messageUsage         MessageUsage[]
  tokenUsage           TokenUsage[]
  messageTemplates     MessageTemplate[]
  faqs                 FAQ[]
  supportTickets       SupportTicket[]
  supportMessages      SupportMessage[]

  @@map("users")
}

// New: AI Agent model - users can create multiple agents
model Agent {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  businessName    String?  // Business name for natural introductions
  description     String?  @db.Text
  businessType    String?  // 'ecommerce', 'realestate', 'education', etc.
  aiTone          String   @default("friendly") // 'professional', 'friendly', 'direct', 'warm'
  responseDelay   Int      @default(5) // Delay in seconds before responding (default 5s)
  isActive        Boolean  @default(true)
  isTemplate      Boolean  @default(false) // Pre-built templates
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  whatsappConnection WhatsAppConnection?
  conversations      Conversation[]
  agentKnowledge     AgentKnowledge[]

  @@index([userId])
  @@map("agents")
}

// Link agents to knowledge base entries
model AgentKnowledge {
  id              String   @id @default(uuid())
  agentId         String
  agent           Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  knowledgeId     String
  knowledge       KnowledgeBase @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([agentId, knowledgeId])
  @@index([agentId])
  @@index([knowledgeId])
  @@map("agent_knowledge")
}

model WhatsAppConnection {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId         String?  @unique
  agent           Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  phoneNumber     String?
  sessionData     Json?    // Baileys session storage
  isConnected     Boolean  @default(false)
  lastActive      DateTime?
  createdAt       DateTime @default(now())

  conversations   Conversation[]

  @@index([userId])
  @@index([agentId])
  @@map("whatsapp_connections")
}

model Conversation {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId               String?
  agent                 Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  whatsappConnectionId  String
  whatsappConnection    WhatsAppConnection @relation(fields: [whatsappConnectionId], references: [id], onDelete: Cascade)
  customerPhone         String
  customerName          String?
  leadScore             String   @default("cold") // 'hot', 'warm', 'cold'
  engagementScore       Int      @default(0) // 0-100 progress bar
  conversationGoal      String   @default("info") // 'booking', 'buying', 'follow-up', 'info', 'support'
  goalAchieved          Boolean  @default(false)
  aiEnabled             Boolean  @default(true)
  aiMode                String   @default("auto") // 'auto', 'copilot', 'manual'
  notes                 String?  @db.Text
  tags                  String?  @db.Text // JSON array: ["Hot Lead", "Follow-up", "VIP"]
  status                String   @default("active") // 'active', 'archived', 'spam'
  assignedTo            String?  // Team member assigned to this conversation
  lastMessageAt         DateTime @default(now())
  createdAt             DateTime @default(now())

  messages              Message[]

  @@index([userId])
  @@index([agentId])
  @@index([whatsappConnectionId])
  @@index([customerPhone]) // PERFORMANCE FIX: Fast lookup by phone number
  @@index([lastMessageAt]) // PERFORMANCE FIX: Sort by recent activity
  @@index([userId, lastMessageAt]) // PERFORMANCE FIX: User's recent conversations
  @@map("conversations")
}

model Message {
  id              String   @id @default(uuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType      String   // 'customer', 'ai', 'user'
  messageText     String?  @db.Text
  mediaUrl        String?
  messageType     String   @default("text") // 'text', 'voice', 'image', 'video', 'document'
  tokensUsed      Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([conversationId])
  @@index([createdAt]) // PERFORMANCE FIX: Time-based queries
  @@index([conversationId, createdAt]) // PERFORMANCE FIX: Conversation history sorted by time
  @@map("messages")
}

model KnowledgeBase {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String?
  content     String   @db.LongText  // Changed to LongText for MySQL (supports up to 4GB)
  sourceType  String   @default("manual") // 'manual', 'pdf', 'word', 'website', 'document'
  sourceUrl   String?  @db.Text
  fileName    String?
  fileSize    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agentKnowledge AgentKnowledge[]

  @@index([userId])
  @@map("knowledge_base")
}

model MessageUsage {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month         String   // Format: '2025-12'
  messagesUsed  Int      @default(0)
  messageLimit  Int      @default(2000)

  @@unique([userId, month])
  @@index([userId])
  @@map("message_usage")
}

// Track OpenAI token usage and costs per user per month
model TokenUsage {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month           String   // Format: '2025-12'
  tokensUsed      Int      @default(0)      // Total tokens used this month
  tokenLimit      Int      @default(500000) // Monthly token limit based on plan
  estimatedCost   Float    @default(0)      // Estimated cost in USD
  requestCount    Int      @default(0)      // Number of API requests
  lastRequestAt   DateTime?                 // Last API request timestamp
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, month])
  @@index([userId])
  @@index([month])
  @@map("token_usage")
}

model MessageTemplate {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  category    String   @default("general") // 'greetings', 'sales', 'support', 'follow-up', 'info', 'general'
  message     String   @db.Text
  usageCount  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("message_templates")
}

model FAQ {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question    String   @db.Text
  answer      String   @db.Text
  category    String   @default("general")
  priority    Int      @default(0) // Higher priority FAQs shown first
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("faqs")
}

// Agent Learning System Models

// Track conversation quality metrics
model ConversationAnalytics {
  id                      String   @id @default(uuid())
  conversationId          String   @unique
  agentId                 String?
  userId                  String

  // Timing metrics
  avgResponseTime         Int?     // Average response time in seconds
  firstResponseTime       Int?     // Time to first response in seconds
  conversationDuration    Int?     // Total conversation duration in minutes

  // Message metrics
  totalMessages           Int      @default(0)
  customerMessages        Int      @default(0)
  agentMessages           Int      @default(0)

  // Quality metrics
  resolutionStatus        String   @default("pending") // 'resolved', 'pending', 'escalated', 'abandoned'
  customerSatisfaction    Float?   // 0-5 rating
  sentimentScore          Float?   // -1 to 1 (negative to positive)

  // Engagement metrics
  messageExchangeRate     Float?   // Messages per minute
  customerEngagement      Int      @default(0) // 0-100 score

  // Learning indicators
  wasSuccessful           Boolean  @default(false)
  goalAchieved            Boolean  @default(false)
  needsImprovement        Boolean  @default(false)

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([agentId])
  @@index([userId])
  @@index([resolutionStatus])
  @@index([wasSuccessful])
  @@map("conversation_analytics")
}

// Store user feedback on agent responses
model AgentFeedback {
  id              String   @id @default(uuid())
  conversationId  String
  agentId         String?
  userId          String
  messageId       String?  // Specific message being rated

  // Feedback data
  rating          Int?     // 1-5 stars
  feedbackType    String   // 'positive', 'negative', 'neutral'
  feedbackTags    String?  @db.Text // JSON array: ['helpful', 'quick', 'accurate']
  comment         String?  @db.Text

  // Context
  wasHelpful      Boolean  @default(true)
  wasAccurate     Boolean  @default(true)
  wasPolite       Boolean  @default(true)

  createdAt       DateTime @default(now())

  @@index([agentId])
  @@index([userId])
  @@index([conversationId])
  @@index([feedbackType])
  @@map("agent_feedback")
}

// Track agent performance over time
model AgentPerformance {
  id                        String   @id @default(uuid())
  agentId                   String
  userId                    String
  period                    String   // Format: '2025-11-16' for daily, '2025-11-W46' for weekly, '2025-11' for monthly
  periodType                String   // 'daily', 'weekly', 'monthly'

  // Volume metrics
  totalConversations        Int      @default(0)
  successfulConversations   Int      @default(0)
  failedConversations       Int      @default(0)

  // Quality metrics
  averageSatisfaction       Float?   // 0-5
  averageSentiment          Float?   // -1 to 1
  resolutionRate            Float?   // Percentage

  // Efficiency metrics
  avgResponseTime           Float?   // Seconds
  avgConversationDuration   Float?   // Minutes
  totalMessagesHandled      Int      @default(0)

  // Learning metrics
  improvementScore          Float?   // 0-100 - how much the agent has improved
  learningRate              Float?   // Rate of improvement

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@unique([agentId, period, periodType])
  @@index([agentId])
  @@index([userId])
  @@index([periodType])
  @@map("agent_performance")
}

// Store learned patterns and insights
model ConversationInsight {
  id                String   @id @default(uuid())
  agentId           String
  userId            String

  // Insight data
  insightType       String   // 'successful_pattern', 'common_question', 'effective_response', 'customer_preference'
  title             String
  description       String   @db.Text

  // Pattern data
  triggerPattern    String?  @db.Text // What triggers this insight (customer message pattern)
  responsePattern   String?  @db.Text // Effective response pattern

  // Metrics
  successRate       Float?   // How often this pattern leads to success
  usageCount        Int      @default(0)
  confidence        Float?   // 0-1 confidence score

  // Context
  category          String?  // 'greeting', 'pricing', 'support', 'objection_handling', etc.
  context           String?  @db.Text // Additional context or examples

  // Status
  isActive          Boolean  @default(true)
  isApproved        Boolean  @default(false) // User can approve insights

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([agentId])
  @@index([userId])
  @@index([insightType])
  @@index([isActive])
  @@map("conversation_insights")
}

// Track agent learning progress
model AgentLearningLog {
  id              String   @id @default(uuid())
  agentId         String
  userId          String

  // Learning event
  eventType       String   // 'insight_discovered', 'pattern_learned', 'performance_improved', 'feedback_received'
  eventData       String   @db.Text // JSON data about the learning event

  // Impact
  impactScore     Float?   // 0-100 - estimated impact of this learning

  // Description
  description     String   @db.Text

  createdAt       DateTime @default(now())

  @@index([agentId])
  @@index([userId])
  @@index([eventType])
  @@map("agent_learning_log")
}

// Support Ticket System
model SupportTicket {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  subject         String   @db.Text
  description     String   @db.Text
  category        String   @default("bug") // 'bug', 'feature_request', 'question', 'billing', 'other'
  priority        String   @default("medium") // 'low', 'medium', 'high', 'urgent'
  status          String   @default("open") // 'open', 'in_progress', 'waiting_response', 'resolved', 'closed'

  // Assignment
  assignedToId    String?  // Admin user ID

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  resolvedAt      DateTime?
  closedAt        DateTime?

  messages        SupportMessage[]

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([assignedToId])
  @@map("support_tickets")
}

model SupportMessage {
  id              String   @id @default(uuid())
  ticketId        String
  ticket          SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  message         String   @db.Text
  isAdminResponse Boolean  @default(false)

  // Attachments (optional)
  attachmentUrl   String?  @db.Text
  attachmentName  String?

  createdAt       DateTime @default(now())

  @@index([ticketId])
  @@index([userId])
  @@index([isAdminResponse])
  @@map("support_messages")
}
