generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String   @id @default(uuid())
  email                String   @unique
  name                 String?
  password             String
  role                 String   @default("user") // 'user', 'admin', 'developer'
  createdAt            DateTime @default(now())
  trialEndsAt          DateTime?
  subscriptionStatus   String   @default("trial") // 'trial', 'active', 'cancelled', 'lifetime', 'expired'
  planType             String   @default("starter") // 'starter', 'professional', 'business'
  stripeCustomerId     String?  @unique

  agents               Agent[]
  whatsappConnections  WhatsAppConnection[]
  conversations        Conversation[]
  knowledgeBase        KnowledgeBase[]
  messageUsage         MessageUsage[]
  messageTemplates     MessageTemplate[]
  faqs                 FAQ[]

  @@map("users")
}

// New: AI Agent model - users can create multiple agents
model Agent {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  description     String?  @db.Text
  businessType    String?  // 'ecommerce', 'realestate', 'education', etc.
  aiTone          String   @default("friendly") // 'professional', 'friendly', 'direct', 'warm'
  isActive        Boolean  @default(true)
  isTemplate      Boolean  @default(false) // Pre-built templates
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  whatsappConnection WhatsAppConnection?
  conversations      Conversation[]
  agentKnowledge     AgentKnowledge[]

  @@index([userId])
  @@map("agents")
}

// Link agents to knowledge base entries
model AgentKnowledge {
  id              String   @id @default(uuid())
  agentId         String
  agent           Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  knowledgeId     String
  knowledge       KnowledgeBase @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([agentId, knowledgeId])
  @@index([agentId])
  @@index([knowledgeId])
  @@map("agent_knowledge")
}

model WhatsAppConnection {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId         String?  @unique
  agent           Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  phoneNumber     String?
  sessionData     Json?    // Baileys session storage
  isConnected     Boolean  @default(false)
  lastActive      DateTime?
  createdAt       DateTime @default(now())

  conversations   Conversation[]

  @@index([userId])
  @@index([agentId])
  @@map("whatsapp_connections")
}

model Conversation {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId               String?
  agent                 Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  whatsappConnectionId  String
  whatsappConnection    WhatsAppConnection @relation(fields: [whatsappConnectionId], references: [id], onDelete: Cascade)
  customerPhone         String
  customerName          String?
  leadScore             String   @default("cold") // 'hot', 'warm', 'cold'
  engagementScore       Int      @default(0) // 0-100 progress bar
  conversationGoal      String   @default("info") // 'booking', 'buying', 'follow-up', 'info', 'support'
  goalAchieved          Boolean  @default(false)
  aiEnabled             Boolean  @default(true)
  aiMode                String   @default("auto") // 'auto', 'copilot', 'manual'
  lastMessageAt         DateTime @default(now())
  createdAt             DateTime @default(now())

  messages              Message[]

  @@index([userId])
  @@index([agentId])
  @@index([whatsappConnectionId])
  @@map("conversations")
}

model Message {
  id              String   @id @default(uuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType      String   // 'customer', 'ai', 'user'
  messageText     String?  @db.Text
  mediaUrl        String?
  messageType     String   @default("text") // 'text', 'voice', 'image', 'video', 'document'
  tokensUsed      Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([conversationId])
  @@map("messages")
}

model KnowledgeBase {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String?
  content     String   @db.LongText  // Changed to LongText for MySQL (supports up to 4GB)
  sourceType  String   @default("manual") // 'manual', 'pdf', 'word', 'website', 'document'
  sourceUrl   String?  @db.Text
  fileName    String?
  fileSize    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agentKnowledge AgentKnowledge[]

  @@index([userId])
  @@map("knowledge_base")
}

model MessageUsage {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month         String   // Format: '2025-12'
  messagesUsed  Int      @default(0)
  messageLimit  Int      @default(2000)

  @@unique([userId, month])
  @@index([userId])
  @@map("message_usage")
}

model MessageTemplate {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  category    String   @default("general") // 'greetings', 'sales', 'support', 'follow-up', 'info', 'general'
  message     String   @db.Text
  usageCount  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("message_templates")
}

model FAQ {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question    String   @db.Text
  answer      String   @db.Text
  category    String   @default("general")
  priority    Int      @default(0) // Higher priority FAQs shown first
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("faqs")
}
