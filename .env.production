# ====================
# PRODUCTION ENVIRONMENT VARIABLES
# Copy these to Railway Dashboard → Variables
# ====================

# ====================
# DATABASE
# ====================
# Railway auto-provides this when you add MySQL plugin
# Format: mysql://user:password@host:port/database?connection_limit=50&pool_timeout=20
DATABASE_URL="${MySQL.DATABASE_URL}"

# ====================
# NODE ENVIRONMENT
# ====================
NODE_ENV=production

# ====================
# OPENAI API
# ====================
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-YOUR-OPENAI-API-KEY-HERE

# ====================
# AUTHENTICATION (NextAuth)
# ====================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=YOUR-GENERATED-32-CHAR-SECRET-HERE
# Your Railway app URL (update after first deploy)
NEXTAUTH_URL=https://your-app-name.up.railway.app

# ====================
# STRIPE PAYMENT
# ====================
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_YOUR-STRIPE-SECRET-KEY
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR-STRIPE-PUBLISHABLE-KEY
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_YOUR-WEBHOOK-SECRET

# Stripe Price IDs (Create in Stripe Dashboard → Products)
# Monthly Plans
STRIPE_PRICE_STARTER_MONTHLY=price_YOUR-STARTER-MONTHLY-ID
STRIPE_PRICE_PRO_MONTHLY=price_YOUR-PRO-MONTHLY-ID
STRIPE_PRICE_BUSINESS_MONTHLY=price_YOUR-BUSINESS-MONTHLY-ID

# Yearly Plans
STRIPE_PRICE_STARTER_YEARLY=price_YOUR-STARTER-YEARLY-ID
STRIPE_PRICE_PRO_YEARLY=price_YOUR-PRO-YEARLY-ID
STRIPE_PRICE_BUSINESS_YEARLY=price_YOUR-BUSINESS-YEARLY-ID

# Lifetime Plans
STRIPE_PRICE_LIFETIME_STARTER=price_YOUR-LIFETIME-STARTER-ID
STRIPE_PRICE_LIFETIME_PRO=price_YOUR-LIFETIME-PRO-ID
STRIPE_PRICE_LIFETIME_BUSINESS=price_YOUR-LIFETIME-BUSINESS-ID

# ====================
# EMAIL CONFIGURATION (PrivateEmail - Namecheap)
# ====================
# Your custom domain email settings
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@whasalesai.com
SMTP_PASSWORD=MArman14

# Application URL (for email links) - update after first deploy
NEXT_PUBLIC_APP_URL=https://your-app-name.up.railway.app

# ====================
# SECURITY SECRETS
# ====================
# Generate with: openssl rand -base64 32
CRON_SECRET=YOUR-GENERATED-32-CHAR-SECRET-HERE
CSRF_SECRET=YOUR-GENERATED-32-CHAR-SECRET-HERE

# ====================
# REDIS (Rate Limiting)
# ====================
# Railway auto-provides this when you add Redis plugin
REDIS_URL="${Redis.REDIS_URL}"

# ====================
# ADMIN SETTINGS
# ====================
# Set to "true" after creating first admin account
ADMIN_CREATION_DISABLED=false

# ====================
# OPTIONAL: GOOGLE OAUTH (If you want Google login)
# ====================
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
