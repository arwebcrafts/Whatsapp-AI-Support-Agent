# ====================
# DATABASE
# ====================
# MySQL connection string
# For production, add connection pool params:
# ?connection_limit=50&pool_timeout=20
DATABASE_URL="mysql://user:password@localhost:3306/whasales"

# ====================
# AI / OPENAI
# ====================
OPENAI_API_KEY="your-openai-api-key"

# ====================
# AUTHENTICATION
# ====================
# NextAuth Secret - CRITICAL: Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# ====================
# APPLICATION URL
# ====================
# CRITICAL: Set this to your actual domain for production!
# Used in emails (verification links, password resets, etc.)
# Development: http://localhost:3000
# Production: https://your-domain.com or Railway URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ====================
# STRIPE PAYMENTS
# ====================
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Stripe Price IDs - Create these in your Stripe Dashboard
STRIPE_PRICE_STARTER_MONTHLY="price_xxx"
STRIPE_PRICE_STARTER_YEARLY="price_xxx"
STRIPE_PRICE_PRO_MONTHLY="price_xxx"
STRIPE_PRICE_PRO_YEARLY="price_xxx"
STRIPE_PRICE_BUSINESS_MONTHLY="price_xxx"
STRIPE_PRICE_BUSINESS_YEARLY="price_xxx"
STRIPE_PRICE_LIFETIME_STARTER="price_xxx"
STRIPE_PRICE_LIFETIME_PRO="price_xxx"
STRIPE_PRICE_LIFETIME_BUSINESS="price_xxx"

# ====================
# SECURITY SETTINGS
# ====================

# Cron Job Secret - CRITICAL: Must be changed!
# Generate with: openssl rand -base64 32
# Used in header 'Authorization: Bearer YOUR_SECRET' for cron endpoints
CRON_SECRET="CHANGE-THIS-TO-A-STRONG-RANDOM-SECRET"

# CSRF Protection Secret - CRITICAL: Must be changed!
# Generate with: openssl rand -base64 32
CSRF_SECRET="CHANGE-THIS-TO-A-STRONG-RANDOM-SECRET"

# ====================
# REDIS (Rate Limiting)
# ====================
# REQUIRED FOR PRODUCTION!
#
# Option 1: Railway Redis (Recommended for Railway)
# - Add Redis plugin in Railway dashboard
# - Railway auto-provides this variable
REDIS_URL="redis://default:password@host:port"
#
# Option 2: Upstash Redis (Alternative - free tier)
# - Sign up at https://upstash.com
# - Create database and get these credentials
# UPSTASH_REDIS_REST_URL="https://your-redis-xxxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-token-here"

# ====================
# EMAIL CONFIGURATION
# ====================
# ✅ RECOMMENDED: Use Resend (HTTP-based, Railway-compatible, 3000 emails/month free)
# Sign up at https://resend.com, create API key
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Domain you verified in Resend (or use their test domain: onboarding@resend.dev)
RESEND_FROM_EMAIL="support@yourdomain.com"

# Alternative: SMTP (May be blocked on Railway/cloud providers)
# Use only if Resend is not configured
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"

# ====================
# GOOGLE OAUTH (Optional)
# ====================
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ====================
# ADMIN SETTINGS
# ====================
# Set to 'true' after creating first admin to prevent re-exploitation
ADMIN_CREATION_DISABLED="false"
